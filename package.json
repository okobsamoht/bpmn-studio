{
  "name": "bpmn-studio",
  "version": "1.0.0",
  "description": "Professional BPMN 2.0 diagram editor with real-time linting and token simulation",
  "main": "dist/main/main.js",
  "author": {
    "name": "Thomas Boko",
    "email": "bokothomas@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/okobsamoht/bpmn-studio.git"
  },
  "homepage": "https://github.com/okobsamoht/bpmn-studio",
  "scripts": {
    "generate-icons": "node scripts/generate-icons.js",
    "build": "npm run generate-icons && webpack --config webpack.main.config.js && webpack --config webpack.renderer.config.js",
    "build:prod": "npm run generate-icons && webpack --config webpack.main.config.js --mode production && webpack --config webpack.renderer.config.js --mode production",
    "dev": "concurrently \"webpack --config webpack.main.config.js --watch\" \"webpack --config webpack.renderer.config.js --watch\"",
    "start": "npm run build && electron .",
    "electron": "electron .",
    "predist": "npm run build:prod",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "release": "electron-builder -p always"
  },
  "dependencies": {
    "electron-updater": "^6.1.8"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "babel-loader": "^9.1.3",
    "bpmn-js": "^17.11.1",
    "bpmn-js-bpmnlint": "^0.22.3",
    "bpmn-js-token-simulation": "^0.38.0",
    "bpmnlint": "^10.2.1",
    "bpmnlint-loader": "^0.1.6",
    "concurrently": "^8.2.2",
    "css-loader": "^6.10.0",
    "electron": "^29.1.4",
    "electron-builder": "^24.13.3",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.0",
    "mini-css-extract-plugin": "^2.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "style-loader": "^3.3.4",
    "uuid": "^9.0.1",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  },
  "build": {
    "appId": "io.bpmnstudio.app",
    "productName": "BPMN Studio",
    "copyright": "Copyright © 2024 Thomas Boko",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "asar": true,
    "extraResources": [],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ]
    },
    "dmg": {
      "background": null,
      "window": { "width": 540, "height": 380 }
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "icon": "build/icons",
      "category": "Development",
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ]
    },
    "publish": {
      "provider": "github",
      "releaseType": "draft"
    }
  }
}
